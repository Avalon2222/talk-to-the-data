# Salin file ini menjadi .streamlit/secrets.toml (sudah di-.gitignore) lalu isi API key-mu.
# Di Streamlit Community Cloud, tempel isi yang sama di Settings → Secrets.

[llm]
provider = "groq"            # "groq" (console.groq.com/keys) atau "gemini" (aistudio.google.com/apikey)
api_key = "gsk_..."
# model = "llama-3.3-70b-versatile"   # opsional; kosongkan untuk memakai model bawaan provider
